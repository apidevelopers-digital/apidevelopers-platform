{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apidevelopers.digital/contracts/evidence/evidence.schema.json",
  "title": "API Developers Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "evidenceType",
    "title",
    "owner",
    "status",
    "issuedAt",
    "subjectRefs",
    "source",
    "integrity",
    "validity",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^evidence\\.[a-z][a-z0-9.-]*$"
    },
    "evidenceType": {
      "type": "string",
      "enum": [
        "test",
        "security-review",
        "observability",
        "runtime",
        "documentation",
        "contract-validation",
        "approval",
        "audit",
        "decision",
        "attestation"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "valid",
        "expired",
        "revoked",
        "superseded"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "subjectRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(asset|capability|solution|org|decision|execution|contract)\\.[a-z][a-z0-9.-]*$"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "system",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "repository",
            "runtime",
            "pipeline",
            "manual-review",
            "external-system",
            "document"
          ]
        },
        "system": {
          "type": "string",
          "minLength": 2
        },
        "ref": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "commitSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{7,64}$"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "verified"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha512",
            "none"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "verifiedBy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "environment",
        "jurisdiction",
        "promotionEligible"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "institutional",
            "platform",
            "asset",
            "solution",
            "organization",
            "execution"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "test",
            "staging",
            "production",
            "sandbox",
            "not-applicable"
          ]
        },
        "jurisdiction": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "promotionEligible": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^evidence\\.[a-z][a-z0-9.-]*$"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
