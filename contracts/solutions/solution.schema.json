{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apidevelopers.digital/contracts/solutions/solution.schema.json",
  "title": "API Developers Solution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "purpose",
    "owner",
    "version",
    "status",
    "capabilities",
    "assets",
    "organizations",
    "environments",
    "dependencies",
    "configuration",
    "evidence",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^solution\\.[a-z][a-z0-9.-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 3
    },
    "purpose": {
      "type": "string",
      "minLength": 12
    },
    "owner": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "blocked",
        "deprecated",
        "retired"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^capability\\.[a-z][a-z0-9.-]*$"
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^asset\\.[a-z][a-z0-9.-]*$"
      },
      "uniqueItems": true
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^org\\.[a-z][a-z0-9.-]*$"
      },
      "uniqueItems": true
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "development",
          "test",
          "staging",
          "production",
          "sandbox"
        ]
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "kind",
          "required"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(solution|asset|capability)\\.[a-z][a-z0-9.-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "solution",
              "asset",
              "capability"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "minimumVersion": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizationScoped",
        "kernelOverridesAllowed",
        "providerBindings"
      ],
      "properties": {
        "organizationScoped": {
          "type": "boolean",
          "const": true
        },
        "kernelOverridesAllowed": {
          "type": "boolean",
          "const": false
        },
        "providerBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capabilityId",
              "provider",
              "bindingType",
              "status"
            ],
            "properties": {
              "capabilityId": {
                "type": "string",
                "pattern": "^capability\\.[a-z][a-z0-9.-]*$"
              },
              "provider": {
                "type": "string",
                "minLength": 2
              },
              "bindingType": {
                "type": "string",
                "enum": [
                  "adapter",
                  "managed-service",
                  "external-system",
                  "internal"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "planned",
                  "active",
                  "blocked",
                  "deprecated"
                ]
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compositionValidated",
        "securityReviewed",
        "runtimeValidated",
        "observability"
      ],
      "properties": {
        "compositionValidated": {
          "type": "boolean"
        },
        "securityReviewed": {
          "type": "boolean"
        },
        "runtimeValidated": {
          "type": "boolean"
        },
        "observability": {
          "type": "boolean"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evidence\\.[a-z][a-z0-9.-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
