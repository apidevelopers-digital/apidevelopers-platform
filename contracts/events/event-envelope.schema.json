{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apidevelopers.digital/contracts/events/event-envelope.schema.json",
  "title": "API Developers Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "eventVersion",
    "producer",
    "tenantId",
    "occurredAt",
    "data"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": {
      "type": "string",
      "minLength": 8
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "eventVersion": {
      "type": "integer",
      "minimum": 1
    },
    "producer": {
      "type": "string",
      "pattern": "^ap\\.[a-z][a-z0-9-]*$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": ["string", "null"]
    },
    "correlationId": {
      "type": ["string", "null"]
    },
    "causationId": {
      "type": ["string", "null"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
