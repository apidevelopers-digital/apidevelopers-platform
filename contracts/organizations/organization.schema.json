{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apidevelopers.digital/contracts/organizations/organization.schema.json",
  "title": "API Developers Organization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "legalName",
    "displayName",
    "organizationType",
    "status",
    "jurisdictions",
    "environments",
    "solutions",
    "assets",
    "capabilities",
    "owners",
    "dataResidency",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^org\\.[a-z][a-z0-9.-]*$"
    },
    "legalName": {
      "type": "string",
      "minLength": 3
    },
    "displayName": {
      "type": "string",
      "minLength": 2
    },
    "organizationType": {
      "type": "string",
      "enum": [
        "client",
        "strategic-client",
        "partner",
        "internal",
        "research",
        "public-sector",
        "nonprofit"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "suspended",
        "offboarding",
        "archived"
      ]
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "countryCode",
          "role",
          "legalEntity"
        ],
        "properties": {
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "incorporation",
              "operation",
              "tax",
              "data",
              "market"
            ]
          },
          "legalEntity": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "development",
          "test",
          "staging",
          "production",
          "sandbox"
        ]
      },
      "uniqueItems": true
    },
    "solutions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^solution\\.[a-z][a-z0-9.-]*$"
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^asset\\.[a-z][a-z0-9.-]*$"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^capability\\.[a-z][a-z0-9.-]*$"
      },
      "uniqueItems": true
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "subject"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "business",
              "technical",
              "security",
              "data",
              "legal",
              "operations"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "dataResidency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "allowedCountries",
        "crossBorderReviewRequired"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "allowedCountries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "uniqueItems": true
        },
        "crossBorderReviewRequired": {
          "type": "boolean"
        }
      }
    },
    "providerBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "provider",
          "bindingType",
          "status"
        ],
        "properties": {
          "capabilityId": {
            "type": "string",
            "pattern": "^capability\\.[a-z][a-z0-9.-]*$"
          },
          "provider": {
            "type": "string",
            "minLength": 2
          },
          "bindingType": {
            "type": "string",
            "enum": [
              "adapter",
              "managed-service",
              "external-system"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "active",
              "blocked",
              "deprecated"
            ]
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
