{
  "schemaVersion": "1.0",
  "app": "mitra-public",
  "domain": "mitra.apidevelopers.digital",
  "runtime": "react-vite",
  "branch": "main",
  "hosting": "hostinger",
  "build": "npm run build",
  "output": "dist",
  "healthcheck": "/",
  "approvalPolicy": "explicit-igor-approval",
  "preview": {
    "required": true,
    "domainPattern": "preview-mitra-public.apidevelopers.digital"
  },
  "release": {
    "byCommit": true,
    "rollbackByCommit": true
  },
  "requiredChecks": [
    "build",
    "test",
    "healthcheck"
  ],
  "requiredSecrets": []
}
