{
  "contractType": "GlobalTrustStagingHarnessManifest",
  "contractVersion": "1.0",
  "mode": "dry-run",
  "environment": "ephemeral",
  "tenantId": "tenant_staging_global_trust_001",
  "provider": {
    "type": "null",
    "contactEnabled": false
  },
