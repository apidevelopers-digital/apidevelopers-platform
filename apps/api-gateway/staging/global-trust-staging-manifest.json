      "name": "missing or injected tenant",
      "action": "tenant-boundary",
      "expectedResult": "deny"
    },
    {
      "id": "STG-03",
      "name": "insufficient scope",
      "action": "authorization",
      "expectedResult": "deny"
    },
    {
      "id": "STG-04",
      "name": "unapproved model",
      "action": "model-registry",
      "expectedResult": "deny"
    },
    {
      "id": "STG-05",
      "name": "incompatible use case",
      "action": "use-case-registry",
      "expectedResult": "deny"
    },
    {
      "id": "STG-06",
      "name": "incompatible data policy",
      "action": "data-policy-registry",
      "expectedResult": "deny"
    },
    {
      "id": "STG-07",
