{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developers.digital/schemas/architecture/exception-snapshot.v1.schema.json",
  "title": "Canonical Architecture Exception Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "repository",
    "branch",
    "exceptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fingerprints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "minProperties": 1
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exceptionId",
        "title",
        "status",
        "ruleIds",
        "scope",
        "justification",
        "owner",
        "approver",
        "createdAt",
        "effectiveFrom",
        "expiresAt",
        "mitigations",
        "remediationPlan",
      "evidenceRefs",
        "reviewCadence",
        "replacementRefs"
      ],
      "properties": {
        "exceptionId": {
          "type": "string",
          "pattern": "^EXC-[A-Z0-9-]{3,64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "expired",
            "revoked",
            "closed"
          ]
        },
        "ruleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ARC-[A-Z0-9]+-[0-9]{3}$"
          }
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "mitigations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "remediationPlan": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewCadence": {
          "type": "string",
          "minLength": 1
        },
        "replacementRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
