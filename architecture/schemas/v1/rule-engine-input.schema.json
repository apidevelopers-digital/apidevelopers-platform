{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developers.digital/schemas/architecture/rule-engine-input.v1.schema.json",
  "title": "Architecture Rule Engine Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "ruleset",
    "scope",
    "execution",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "owner",
        "name",
        "branch",
        "commitSha",
        "workspacePath"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workspacePath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expectedId",
        "expectedVersion"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "expectedId": {
          "type": "string",
          "minLength": 1
        },
        "expectedVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "exceptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "required"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "include",
        "exclude"
      ],
      "properties": {
        "mode": {
          "enum": [
            "repository",
            "changed-files",
            "paths",
            "packages",
            "services",
            "graph-impact"
          ]
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "changed-files"
              }
            }
          },
          "then": {
            "required": [
              "baseSha",
              "headSha"
            ]
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "failThreshold",
        "parallelism",
        "timeoutMs"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local",
            "ci",
            "portal"
          ]
        },
        "failThreshold": {
          "enum": [
            "INFO",
            "WARN",
            "ERROR",
            "CRITICAL"
          ]
        },
        "parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "json",
        "markdown",
        "sarif"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "json": {
          "type": "boolean"
        },
        "markdown": {
          "type": "boolean"
        },
        "sarif": {
          "type": "boolean"
        }
      }
    }
  }
}
